{
  "name": "cannon-war-server",
  "version": "1.0.0",
  "description": "Colyseus multiplayer server for Cannon War",
  "type": "module",
  "main": "dist/server/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && echo '✓ Server built successfully'",
    "start": "node dist/server/src/index.js",
    "start:prod": "NODE_ENV=production node dist/server/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.22",
    "@colyseus/monitor": "^0.16.7",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "colyseus.js": "^0.16.22",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "nanoid": "file:./compat/nanoid"
  }
}
